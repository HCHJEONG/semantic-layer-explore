NODE_ENV=production
PORT=3000
SITE_URL=https://ai-workspace.sampoongapt.com
NEXT_PUBLIC_SITE_URL=https://ai-workspace.sampoongapt.com

PHYSICAL_ADAPTER=simulator
SIMULATOR_INTERVAL_MS=2000
SIMULATOR_SEED=20260804

DATABASE_PATH=/app/data/ai-workspace.sqlite
READING_RETENTION_DAYS=7
AUDIT_EVENT_RETENTION_DAYS=30
RETENTION_CLEANUP_INTERVAL_MS=3600000
RETENTION_BATCH_SIZE=5000

GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-key.json
GEMINI_MODEL=gemini-3.5-flash-lite
