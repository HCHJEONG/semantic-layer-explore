# aws-demo runtime environment template
#
# Copy this file to /home/ubuntu/semantic-layer-explore/.env.local on aws-demo,
# replace every placeholder you keep, and preserve the KEY=value format.
# For an optional setting, either replace its placeholder or delete the whole
# KEY=value line to use the documented Compose fallback. Do not leave a
# placeholder in the deployed file.
#
# PHYSICALAI_VERSION, GCP_KEY_ON_PRIVATE, FRONTEND_HOST_PORT, and
# API_HTTP_HOST_PORT are intentionally absent. deploy.sh writes those values to
# each release's .deployment.env and gives that file higher precedence.
# MQTT_CLIENT_ID and INSTANCE_ID are also intentionally absent. Each Compose
# Gateway replica must derive its identity from its unique container hostname.

# Required; no fallback. Use a URL-safe value of at least 32 characters.
POSTGRES_PASSWORD=<replace-with-32-plus-character-url-safe-password>

# Required; no fallback. Use a URL-safe value of at least 32 characters.
NEO4J_PASSWORD=<replace-with-32-plus-character-url-safe-password>

# Optional; fallback: global. Replace this value or delete this KEY=value line.
GOOGLE_CLOUD_LOCATION=<replace-with-google-cloud-location>

# Optional; fallback: empty and inferred from the mounted service-account JSON. Replace or delete this line.
GOOGLE_CLOUD_PROJECT=<replace-with-google-cloud-project-id>

# Optional; fallback: gemini-3.5-flash-lite. Replace this value or delete this KEY=value line.
GEMINI_MODEL=<replace-with-gemini-model>

# Optional; fallback: disabled. Allowed deployment value: disabled or enabled. Replace or delete this line.
EXPLAIN_LLM_REVIEW=<replace-with-disabled-or-enabled>

# Optional; fallback: dry-run. Replace this value or delete this KEY=value line.
MASTRA_TELEMETRY_MODE=<replace-with-mastra-telemetry-mode>

# Optional; fallback: 31.5. Replace this value or delete this KEY=value line.
MASTRA_TEMPERATURE_THRESHOLD=<replace-with-temperature-threshold>

# Optional; fallback: 10. Replace this value or delete this KEY=value line.
MASTRA_DISTANCE_THRESHOLD=<replace-with-distance-threshold>

# Optional; fallback: pago. Replace this value or delete this KEY=value line.
MQTT_CLIENT_ID_PREFIX=<replace-with-portable-client-id-prefix>

# Optional; fallback: physicalai-telemetry. Replace this value or delete this KEY=value line.
MQTT_TELEMETRY_SHARED_GROUP=<replace-with-telemetry-shared-group>

# Optional; fallback: physicalai-command-results. Replace this value or delete this KEY=value line.
MQTT_COMMAND_RESULT_SHARED_GROUP=<replace-with-command-result-shared-group>

# Optional; fallback: 10 seconds. Replace this value or delete this KEY=value line.
COMMAND_ACK_TIMEOUT_SECONDS=<replace-with-positive-seconds>

# Optional; fallback: 30 seconds. Replace this value or delete this KEY=value line.
MQTT_COMMAND_LEASE_SECONDS=<replace-with-positive-seconds>

# Optional; fallback: 3 attempts. Replace this value or delete this KEY=value line.
MQTT_COMMAND_MAX_PUBLISH_ATTEMPTS=<replace-with-positive-attempt-count>

# Optional; fallback: 500 milliseconds. Replace this value or delete this KEY=value line.
MQTT_COMMAND_RETRY_INITIAL_MS=<replace-with-positive-milliseconds>

# Optional; fallback: 5000 milliseconds. Replace this value or delete this KEY=value line.
MQTT_COMMAND_RETRY_MAX_MS=<replace-with-positive-milliseconds>

# Optional; fallback: workspace-simulator-01. Replace this value or delete this KEY=value line.
SIMULATOR_DEVICE_ID=<replace-with-simulator-device-id>

# Optional; fallback: 60. Replace this value or delete this KEY=value line.
SIMULATOR_EVENTS_PER_HOUR=<replace-with-positive-events-per-hour>

# Optional; fallback: 20260804. Replace this value or delete this KEY=value line.
SIMULATOR_SEED=<replace-with-integer-seed>

# Optional; fallback: normal. Replace this value or delete this KEY=value line.
SIMULATOR_SCENARIO=<replace-with-simulator-scenario>

# Optional; fallback: true. Replace this value or delete this KEY=value line.
SIM_COMMAND_ACK_ENABLED=<replace-with-true-or-false>

# Optional; fallback: 100 milliseconds. Replace this value or delete this KEY=value line.
SIM_COMMAND_ACK_DELAY_MS=<replace-with-non-negative-milliseconds>

# Optional; fallback: 0.01. Replace this value or delete this KEY=value line.
SIM_COMMAND_FAILURE_RATE=<replace-with-decimal-from-0-to-1>

# Optional; fallback: 0. Replace this value or delete this KEY=value line.
SIM_COMMAND_ACK_DROP_RATE=<replace-with-decimal-from-0-to-1>

# Optional; fallback: 7474. This affects the private loopback Neo4j HTTP binding. Replace or delete this line.
NEO4J_HTTP_HOST_PORT=<replace-with-host-port>

# Optional; fallback: 7687. This affects the private loopback Neo4j Bolt binding. Replace or delete this line.
NEO4J_BOLT_HOST_PORT=<replace-with-host-port>
