# aws-demo runtime environment template
#
# Copy this file to /home/ubuntu/semantic-layer-explore/.env.local on aws-demo,
# replace the two required secret placeholders, and preserve KEY=value format.
# Optional values below are already set to the same values as their Compose
# fallbacks. They may be kept as-is, changed explicitly, or deleted.
#
# PHYSICALAI_VERSION, GCP_KEY_ON_PRIVATE, FRONTEND_HOST_PORT, and
# API_HTTP_HOST_PORT are intentionally absent. deploy.sh writes those values to
# each release's .deployment.env and gives that file higher precedence.
# MQTT_CLIENT_ID and INSTANCE_ID are also intentionally absent. Each Compose
# Gateway replica must derive its identity from its unique container hostname.

# Required; no fallback. Use a URL-safe value of at least 32 characters.
POSTGRES_PASSWORD=<replace-with-32-plus-character-url-safe-password>

# Required; no fallback. Use a URL-safe value of at least 32 characters.
NEO4J_PASSWORD=<replace-with-32-plus-character-url-safe-password>

# Optional; Compose fallback: global.
GOOGLE_CLOUD_LOCATION=global

# Optional; Compose fallback: empty and inferred from the mounted service-account JSON.
GOOGLE_CLOUD_PROJECT=

# Optional; Compose fallback: gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional; Compose fallback: gemini. The current code supports gemini.
LLM_PROVIDER=gemini

# Optional; Compose fallback: disabled. Allowed deployment value: disabled or enabled.
EXPLAIN_LLM_REVIEW=disabled

# Optional; Compose fallback: 10 requests per visitor and UTC day.
ASK_AI_DAILY_LIMIT=10

# Optional; Compose fallback: 5 requests per visitor and UTC day.
EXPLAIN_AI_DAILY_LIMIT=5

# Optional; Compose fallback: dry-run.
MASTRA_TELEMETRY_MODE=dry-run

# Optional; Compose fallback: 31.5.
MASTRA_TEMPERATURE_THRESHOLD=31.5

# Optional; Compose fallback: 10.
MASTRA_DISTANCE_THRESHOLD=10

# Optional; Compose fallback: pago.
MQTT_CLIENT_ID_PREFIX=pago

# Optional; Compose fallback: physicalai-telemetry.
MQTT_TELEMETRY_SHARED_GROUP=physicalai-telemetry

# Optional; Compose fallback: physicalai-command-results.
MQTT_COMMAND_RESULT_SHARED_GROUP=physicalai-command-results

# Optional; Compose fallback: 10 seconds.
COMMAND_ACK_TIMEOUT_SECONDS=10

# Optional; Compose fallback: 30 seconds.
MQTT_COMMAND_LEASE_SECONDS=30

# Optional; Compose fallback: 3 attempts.
MQTT_COMMAND_MAX_PUBLISH_ATTEMPTS=3

# Optional; Compose fallback: 500 milliseconds.
MQTT_COMMAND_RETRY_INITIAL_MS=500

# Optional; Compose fallback: 5000 milliseconds.
MQTT_COMMAND_RETRY_MAX_MS=5000

# Optional; Compose fallback: workspace-simulator-01.
SIMULATOR_DEVICE_ID=workspace-simulator-01

# Optional; Compose fallback: 60.
SIMULATOR_EVENTS_PER_HOUR=60

# Optional; Compose fallback: 20260804.
SIMULATOR_SEED=20260804

# Optional; Compose fallback: normal.
SIMULATOR_SCENARIO=normal

# Optional; Compose fallback: true.
SIM_COMMAND_ACK_ENABLED=true

# Optional; Compose fallback: 100 milliseconds.
SIM_COMMAND_ACK_DELAY_MS=100

# Optional; Compose fallback: 0.01.
SIM_COMMAND_FAILURE_RATE=0.01

# Optional; Compose fallback: 0.
SIM_COMMAND_ACK_DROP_RATE=0

# Optional; Compose fallback: 7474. This affects the private loopback Neo4j HTTP binding.
NEO4J_HTTP_HOST_PORT=7474

# Optional; Compose fallback: 7687. This affects the private loopback Neo4j Bolt binding.
NEO4J_BOLT_HOST_PORT=7687

# Active; Compose fallback: 1 day. Deletes old telemetry and sensor-reading event payloads.
READING_RETENTION_DAYS=1

# Active; Compose fallback: 7 days. Excludes permanent rule idempotency markers.
AUDIT_EVENT_RETENTION_DAYS=7

# Active; Compose fallback: 3600000 milliseconds (1 hour).
RETENTION_CLEANUP_INTERVAL_MS=3600000

# Active; Compose fallback: 5000 rows per table and cleanup run.
RETENTION_BATCH_SIZE=5000
