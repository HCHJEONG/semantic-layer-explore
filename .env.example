# Application
NODE_ENV=development
PORT=3000
INTERNAL_API_ORIGIN=http://127.0.0.1:3000
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Physical runtime
PHYSICAL_ADAPTER=simulator
SIMULATOR_INTERVAL_MS=2000
SIMULATOR_SEED=20260804

# Storage
DATABASE_PATH=./data/ai-workspace.sqlite
DB_PROVIDER=sqlite
READING_RETENTION_DAYS=7
AUDIT_EVENT_RETENTION_DAYS=30
RETENTION_CLEANUP_INTERVAL_MS=3600000
RETENTION_BATCH_SIZE=5000

# Gemini / Vertex AI — aligned with the shared Vertex AI production setup
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=path/to/gcp-key.json
GEMINI_MODEL=gemini-3.5-flash-lite
EXPLAIN_LLM_REVIEW=disabled

# Future MQTT adapter (unused while PHYSICAL_ADAPTER=simulator)
MQTT_URL=mqtts://mqtt-ai-workspace.example.com:8883
MQTT_USERNAME=
MQTT_PASSWORD=
