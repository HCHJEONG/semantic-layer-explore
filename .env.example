# Application
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Physical runtime
PHYSICAL_ADAPTER=simulator
SIMULATOR_INTERVAL_MS=2000
SIMULATOR_SEED=20260804

# Storage
DATABASE_PATH=./data/ai-workspace.sqlite

# Gemini / Vertex AI — aligned with sampoongaptcom
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=path/to/gcp-key.json
GEMINI_MODEL=gemini-3.5-flash-lite

# Future MQTT adapter (unused while PHYSICAL_ADAPTER=simulator)
MQTT_URL=mqtts://mqtt-ai-workspace.example.com:8883
MQTT_USERNAME=
MQTT_PASSWORD=
