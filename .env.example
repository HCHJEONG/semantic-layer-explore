# Local development example. For the copy-and-replace aws-demo runtime file,
# use .fordeploy/.env.example instead.

# Application
NODE_ENV=development
PORT=3000
INTERNAL_API_ORIGIN=http://127.0.0.1:3000
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Python MQTT simulator
SIMULATOR_SEED=20260804
SIMULATOR_EVENTS_PER_HOUR=60
SIMULATOR_SCENARIO=normal
SIM_COMMAND_ACK_ENABLED=true
SIM_COMMAND_ACK_DELAY_MS=100
SIM_COMMAND_FAILURE_RATE=0.01
SIM_COMMAND_ACK_DROP_RATE=0
MQTT_COMMAND_MAX_PUBLISH_ATTEMPTS=3
MQTT_COMMAND_LEASE_SECONDS=30
MQTT_COMMAND_RETRY_INITIAL_MS=500
MQTT_COMMAND_RETRY_MAX_MS=5000

# Gemini / Vertex AI — aligned with the shared Vertex AI production setup
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=path/to/gcp-key.json
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=gemini
EXPLAIN_LLM_REVIEW=disabled
ASK_AI_DAILY_LIMIT=10
EXPLAIN_AI_DAILY_LIMIT=5

# Distributed second-stage stack
GO_GATEWAY_URL=http://localhost:8080
API_HTTP_ADDR=:8080
API_SSH_ADDR=:2222
KAFKA_BROKERS=localhost:9092
KAFKA_TELEMETRY_TOPIC=telemetry.raw
KAFKA_DEAD_LETTER_TOPIC=dead-letter
KAFKA_AGENT_RESULT_TOPIC=agent.result
KAFKA_TELEMETRY_GROUP=physicalai-telemetry-workers
MASTRA_TELEMETRY_MODE=dry-run
MASTRA_TEMPERATURE_THRESHOLD=31.5
MASTRA_DISTANCE_THRESHOLD=10
READING_RETENTION_DAYS=1
AUDIT_EVENT_RETENTION_DAYS=7
RETENTION_CLEANUP_INTERVAL_MS=3600000
RETENTION_BATCH_SIZE=5000
MQTT_TELEMETRY_TOPIC=devices/+/telemetry
MQTT_CLIENT_ID_PREFIX=pago
# Kubernetes injects the Pod UID into INSTANCE_ID; Compose falls back to its container hostname.
INSTANCE_ID=
MQTT_TELEMETRY_SHARED_GROUP=physicalai-telemetry
MQTT_COMMAND_RESULT_SHARED_GROUP=physicalai-command-results
POSTGRES_DB=physicalai
POSTGRES_USER=physicalai
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://physicalai:change-me@localhost:5432/physicalai
GRAPH_CONSUMER_GROUP=physicalai-graph-projectors
NEO4J_URI=bolt://localhost:7687
NEO4J_PASSWORD=change-me
