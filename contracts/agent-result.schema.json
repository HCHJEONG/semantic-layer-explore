{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bestai.com/contracts/agent-result.schema.json",
  "title": "AgentResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resultId", "kind", "status", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "agent-result.v1" },
    "resultId": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["explain-event", "rule-proposal", "impact-analysis"] },
    "status": { "enum": ["succeeded", "failed", "skipped"] },
    "summary": { "type": "string" },
    "payload": { "type": "object" },
    "createdAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string" },
    "sessionId": { "type": "string" }
  }
}
