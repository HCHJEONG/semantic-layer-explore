{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bestai.com/contracts/command-result.schema.json",
  "title": "CommandResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commandId", "deviceId", "success", "occurredAt"],
  "properties": {
    "schemaVersion": { "const": "command-result.v1" },
    "commandId": { "type": "string", "minLength": 1 },
    "deviceId": { "type": "string", "minLength": 1 },
    "success": { "type": "boolean" },
    "state": { "type": "object" },
    "error": { "type": "string" },
    "failureCode": { "type": "string", "minLength": 1 },
    "publishAttempts": { "type": "integer", "minimum": 0 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string" },
    "sessionId": { "type": "string" }
  }
}
